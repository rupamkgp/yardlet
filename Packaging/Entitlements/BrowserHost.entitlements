<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Chromium's browser process: passkeys from a phone (Bluetooth) and USB security keys, and the
         camera and microphone a site uses once the person allowed it in the panel's bar (Chromium
         captures video in the browser process on macOS). Chromium's own list is
         chrome/app/app-entitlements.plist; location and photos stay out until Yardlet says why it uses them. -->
    <key>com.apple.security.device.bluetooth</key>
    <true/>
    <key>com.apple.security.device.usb</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
