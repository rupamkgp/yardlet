<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Yardlet Helper (Renderer) and (GPU): V8 and the GPU process generate code, as Chrome's
         helper-renderer- and helper-gpu-entitlements.plist allow. The other helpers need none. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
